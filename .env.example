# .env.example v1.0
# Переменные окружения для Flask приложения и MCTS агента
# Скопируйте этот файл в .env и установите свои значения (если нужно)

# Настройки Flask/Gunicorn (часто устанавливаются платформой хостинга)
# FLASK_APP=app.py # Обычно устанавливается через ENV или командную строку
PORT=10000
WEB_CONCURRENCY=2 # Количество Gunicorn воркеров

# Режим отладки Flask (0 или 1). НЕ ИСПОЛЬЗОВАТЬ '1' В ПРОДАКШЕНЕ!
FLASK_DEBUG=0

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Настройки MCTS Агента (используются в app.py для инициализации MCTSAgent)
# Время на ход AI в миллисекундах (например, 5000 = 5 секунд)
MCTS_TIME_LIMIT_MS=5000

# Количество параллельных воркеров для MCTS (по умолчанию: CPU_COUNT - 1, макс 8)
# NUM_WORKERS=4

# Количество роллаутов на каждый лист дерева MCTS (по умолчанию: 4)
# ROLLOUTS_PER_LEAF=4
